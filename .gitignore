# ===== macOS =====
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage / type checking / linting
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/

# Jupyter
.ipynb_checkpoints/

# ===== Secrets / config local =====
.env
.env.*
!.env.example

# ===== RAG / LLM artifacts =====
# Bases vectoriales persistidas localmente (Chroma, FAISS, Qdrant, etc.)
chroma/
chroma_db/
.chroma/
*.faiss
qdrant_storage/
# Cachés de modelos / embeddings
.cache/
models/
*.gguf
*.safetensors
*.bin
# Logs y trazas
logs/
*.log
wandb/
mlruns/

# ===== Editores =====
.vscode/
.idea/
*.swp
*~

# ===== Archivos de trabajo de agentes (no se pushean) =====
docs/agents/

# ===== Dataset crudo =====
# Se versionan index.json y los manifest.json (reproducibles por commit); el resto se descarga.
data/raw/*/*
!data/raw/*/manifest.json

# ===== Dataset normalizado =====
# Se regenera desde data/raw con src/scripts/normalize_docs.py.
data/normalized/

# ===== Chunks =====
# Se regeneran desde data/normalized con src/scripts/split_docs.py.
data/processed/

# ===== Resultados de experimentos =====
# Por ahora se ignoran: los de la fase 0 (results/phase0/) se regeneran gratis en segundos con
# src/scripts/phase0_metrics.py.
# IMPORTANTE: antes de correr experimentos que gastan API (embeddings, evaluación, ablación), decidir si esos
# resultados se versionan. Regenerarlos cuesta plata (presupuesto total: 10 USD) y la entrega final es "repo + hash
# del commit": los números de la presentación tienen que poder rastrearse hasta ese commit. Opción: sacar esta regla
# (o agregar excepciones con !results/<carpeta>/) y versionar results/ salvo las muestras de revisión manual.
results/
